# CompanyPrep AI — Environment Configuration
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# AI Provider: "gemini" or "groq"
AI_PROVIDER=gemini

# Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (get from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Groq model (optional, default: llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# Gemini model (optional, default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# App mode: "production" or "demo"
# Leave blank to auto-detect based on API key availability
APP_MODE=
